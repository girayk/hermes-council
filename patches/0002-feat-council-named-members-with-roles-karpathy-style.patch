+describe('ModelSettings Council preset editor', () => {
+  const councilConfig = () => ({
+    default_preset: 'default',
+    active_preset: '',
+    presets: {
+      default: {
+        members: [
+          { provider: 'nous', model: 'hermes-4', name: 'Skeptic', role: 'Challenge assumptions and find flaws' },
+          { provider: 'openrouter', model: 'deepseek/deepseek-v4-pro' }
+        ],
+        judge: { provider: '', model: '', name: '' },
+        chairman: { provider: 'openrouter', model: 'anthropic/claude-opus-4.8', name: 'Foreman' },
+        lite: false,
+        enabled: true,
+        member_temperature: null,
+        chairman_temperature: null
+      }
+    },
+    members: [
+      { provider: 'nous', model: 'hermes-4', name: 'Skeptic', role: 'Challenge assumptions and find flaws' },
+      { provider: 'openrouter', model: 'deepseek/deepseek-v4-pro' }
+    ],
+    judge: { provider: '', model: '', name: '' },
+    chairman: { provider: 'openrouter', model: 'anthropic/claude-opus-4.8', name: 'Foreman' },
+    lite: false,
+    enabled: true
+  })
+
+  beforeEach(() => {
+    getGlobalModelOptions.mockResolvedValue({
+      providers: [
+        {
+          name: 'Nous',
+          slug: 'nous',
+          models: ['hermes-4', 'hermes-4-mini'],
+          authenticated: true,
+          capabilities: { 'hermes-4': { reasoning: true, fast: true } }
+        },
+        {
+          name: 'OpenRouter',
+          slug: 'openrouter',
+          models: ['deepseek/deepseek-v4-pro', 'anthropic/claude-opus-4.8'],
+          authenticated: true
+        }
+      ]
+    })
+    getCouncilModels.mockResolvedValue(councilConfig())
+    saveCouncilModels.mockImplementation((body: unknown) => Promise.resolve(body))
+  })
+
+  async function openCouncilEditor() {
+    renderModelSettings()
+    // The named member's header proves name round-trips into the row title.
+    expect(await screen.findByText('Member 1 — Skeptic')).toBeTruthy()
+    expect(screen.getByText('Member 2')).toBeTruthy()
+  }
+
+  it('renders member name/role inputs pre-filled from the loaded config', async () => {
+    await openCouncilEditor()
+
+    const names = screen.getAllByPlaceholderText('Name (e.g. Skeptic)')
+    const roles = screen.getAllByPlaceholderText('Duty on the council (steers its answer)')
+
+    expect(names).toHaveLength(2)
+    expect(roles).toHaveLength(2)
+    expect((names[0] as HTMLInputElement).value).toBe('Skeptic')
+    expect((roles[0] as HTMLInputElement).value).toBe('Challenge assumptions and find flaws')
+    expect((names[1] as HTMLInputElement).value).toBe('')
+
+    // Judge + Chairman carry their own optional name inputs.
+    expect(screen.getAllByPlaceholderText('Name (optional)')).toHaveLength(2)
+    expect((screen.getAllByPlaceholderText('Name (optional)')[1] as HTMLInputElement).value).toBe('Foreman')
+  })
+
+  it('autosaves a typed member name/role in the debounced council payload', async () => {
+    vi.useFakeTimers({ shouldAdvanceTime: true })
+
+    try {
+      await openCouncilEditor()
+
+      const names = screen.getAllByPlaceholderText('Name (e.g. Skeptic)')
+      const roles = screen.getAllByPlaceholderText('Duty on the council (steers its answer)')
+
+      fireEvent.change(names[1], { target: { value: 'Historian' } })
+      fireEvent.change(roles[1], { target: { value: 'Provide prior context' } })
+      await vi.advanceTimersByTimeAsync(700)
+
+      expect(saveCouncilModels).toHaveBeenCalled()
+      const sent = saveCouncilModels.mock.calls.at(-1)![0] as ReturnType<typeof councilConfig>
+      expect(sent.presets.default.members[1]).toEqual({
+        provider: 'openrouter',
+        model: 'deepseek/deepseek-v4-pro',
+        name: 'Historian',
+        role: 'Provide prior context'
+      })
+      // The untouched named member rides along unchanged.
+      expect(sent.presets.default.members[0]).toEqual({
+        provider: 'nous',
+        model: 'hermes-4',
+        name: 'Skeptic',
+        role: 'Challenge assumptions and find flaws'
+      })
+      // The row header follows the typed name live.
+      expect(screen.getByText('Member 2 — Historian')).toBeTruthy()
+    } finally {
+      vi.useRealTimers()
+    }
+  })
+})
