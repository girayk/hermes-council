+def _model_flow_council(config, current_model=""):
+    """Council virtual provider: pick a preset (list always shown, even with one entry),
+    persist it, print the breakdown. No credential step — presets reference configured
+    providers. Fork of ``_model_flow_moa``."""
+    from hermes_cli.auth import _save_model_choice
+    from hermes_cli.council_config import normalize_council_config
+    council = normalize_council_config(config.get("council") if isinstance(config, dict) else {})
+    presets = council.get("presets") or {}
+    if not presets:
+        print("No Council presets configured. Run `hermes council configure <name>` first.")
+        return
+
+    names = list(presets.keys())
+    default_name = council.get("default_preset") or names[0]
+    # Rows show the chairman as the acting/billed model so the picker is informative before drilling in.
+    rows = []
+    for n in names:
+        chair = presets[n].get("chairman") or {}
+        chair_label = f"{chair.get('provider')}:{chair.get('model')}" if chair else ""
+        member_count = len(presets[n].get("members") or [])
+        judge = presets[n].get("judge") or {}
+        review_label = "judge" if judge.get("provider") else "peer review"
+        suffix = "  ← default" if n == default_name else ""
+        rows.append(f"{n}  (acting: {chair_label}, {member_count} members, {review_label}){suffix}")
+    default_idx = names.index(default_name) if default_name in names else 0
+
+    title = "Select a Council preset:"
+    idx = _curses_choice(title, rows, default_idx)
+    if idx is None:
+        _print_numbered(title, rows, default_idx)
+        raw = _ask(f"  Choice [1-{len(rows)}]: ", raw=True, cancel_msg="No change.")
+        if raw is None:
+            return
+        try:
+            idx = default_idx if not raw else max(0, min(len(rows) - 1, int(raw) - 1))
+        except ValueError:
+            print("No change.")
+            return
+    if idx < 0:
+        print("No change.")
+        return
+
+    selected_name = names[idx]
+    cfg, model = _load_config_model_section()
+    model["default"] = selected_name
+    model["provider"] = "council"
+    # Virtual local provider: drop stale endpoint credentials AND base_url (which
+    # clear_model_endpoint_credentials intentionally leaves alone).
+    clear_model_endpoint_credentials(model, clear_api_mode=True)
+    model.pop("base_url", None)
+    _commit_model_config(cfg)
+    _save_model_choice(selected_name)
+
+    preset = presets[selected_name]
+    _say(
+        "",
+        f"Default model set to: {selected_name} (via Council)",
+        f"  Preset: {selected_name}",
+        "  Members (answer once per user turn, then review):",
+    )
+    for i, slot in enumerate(preset.get("members") or [], start=1):
+        print(f"    {i}. {slot.get('provider')}:{slot.get('model')}")
+    judge = preset.get("judge") or {}
+    if judge.get("provider"):
+        print(f"  Judge:       {judge.get('provider')}:{judge.get('model')}  (ranks the anonymized answers)")
+    else:
+        print("  Judge:       (unset — members review each other anonymously)")
+    chair = preset.get("chairman") or {}
+    print(
+        f"  Chairman:    {chair.get('provider')}:{chair.get('model')}  (acting model — runs every step and carries almost all of the cost)"
+    )
+
+
