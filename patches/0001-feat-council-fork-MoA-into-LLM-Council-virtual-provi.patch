+def _progress_council_member(sid, name, preview, kw):
+    # One council member's stage-1 answer; lands in the reasoning disclosure like moa.reference.
+    if not _session_show_reasoning(sid):
+        return
+    member_payload: dict[str, object] = {"label": str(name), "text": str(preview or "")}
+    for key, out in (("council_index", "index"), ("council_count", "count")):
+        if kw.get(key) is not None:
+            member_payload[out] = kw[key]
+    _emit("council.member", sid, member_payload)
+
+
+def _progress_council_review(sid, name, preview, kw):
+    # A stage-2 review verdict: `name` is the reviewer model id, `council_ranking` the label order.
+    if not _session_show_reasoning(sid):
+        return
+    review_payload: dict[str, object] = {
+        "reviewer": str(name or ""), "text": str(preview or "")}
+    for key, out in (("council_index", "index"), ("council_count", "count"), ("council_ranking", "ranking")):
+        if kw.get(key) is not None:
+            review_payload[out] = kw[key]
+    _emit("council.review", sid, review_payload)
+
+
+def _progress_council_phase(sid, name, preview, kw):
+    # phase="review"|"chairman"; drives the council status line (members_done/total).
+    phase = kw.get("council_phase")
+    if not phase or not _session_show_reasoning(sid):
+        return
+    phase_payload: dict[str, object] = {"phase": str(phase)}
+    for key, out in (("council_members_done", "members_done"), ("council_members_total", "members_total")):
+        if kw.get(key) is not None:
+            phase_payload[out] = int(kw[key])
+    if name:
+        phase_payload["chairman"] = str(name)
+    _emit("council.phase", sid, phase_payload)
+
+
+def _progress_council_synthesizing(sid, name, preview, kw):
+    # The chairman started acting (twin of moa.aggregating: frame kept under answer-only too).
+    payload: dict[str, object] = {"chairman": str(name or "")}
+    if kw.get("council_member_count") is not None:
+        payload["member_count"] = int(kw["council_member_count"])
+    _emit("council.synthesizing", sid, payload)
+
