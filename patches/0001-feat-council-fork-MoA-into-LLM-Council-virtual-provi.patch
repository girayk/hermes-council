+    council_subparsers.add_parser("list", aliases=["ls"], help="Show current Council model slots")
+    council_configure = council_subparsers.add_parser(
+        "configure", aliases=["config"], help="Interactively pick Council models")
+    council_configure.add_argument("name", nargs="?", help="Preset name to create or update")
+    council_delete = council_subparsers.add_parser("delete", aliases=["rm"], help="Delete a Council preset")
+    council_delete.add_argument("name", help="Preset name to delete")
+    council_parser.set_defaults(func=cmd_council)
