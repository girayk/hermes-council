@@ -0,0 +1,145 @@
+"""Tests for hermes_cli/council_config.py — name/role support on council slots.
+
+Follows tests/hermes_cli/test_moa_config.py patterns: read-time tolerance
+(normalize) vs write-time strictness (validate), plus a save/load round-trip
+under an isolated HERMES_HOME.
+"""
+
+import pytest
+
+from hermes_cli.council_config import (
+    council_config_complete,
+    normalize_council_config,
+    resolve_council_preset,
+    save_council_config,
+    validate_council_payload,
+)
+
+
+def _payload(**member_extra):
+    member = {"provider": "openrouter", "model": "m1", **member_extra}
+    return {
+        "presets": {
+            "p": {
+                "members": [member],
+                "judge": {"provider": "", "model": ""},
+                "chairman": {"provider": "openrouter", "model": "chair", "name": "The Chair"},
+            }
+        }
+    }
+
+
+# ── normalize: round-trip name/role ─────────────────────────────────────────
+
+
+def test_normalize_roundtrips_member_name_and_role():
+    cfg = normalize_council_config(_payload(name="Skeptic", role="Challenge every assumption."))
+    member = cfg["presets"]["p"]["members"][0]
+    assert member["name"] == "Skeptic"
+    assert member["role"] == "Challenge every assumption."
+    assert member["provider"] == "openrouter" and member["model"] == "m1"
+    assert member["enabled"] is True
+
+
+def test_normalize_strips_whitespace_and_drops_empty_name_role():
+    cfg = normalize_council_config(_payload(name="  Padded  ", role="   "))
+    member = cfg["presets"]["p"]["members"][0]
+    assert member["name"] == "Padded"
+    # Empty string means unset: the key is dropped (minimal slot convention).
+    assert "role" not in member
+
+
+def test_normalize_drops_unset_name_role_keys():
+    cfg = normalize_council_config(_payload())
+    member = cfg["presets"]["p"]["members"][0]
+    assert "name" not in member
+    assert "role" not in member
+
+
+def test_normalize_truncates_overlong_name_and_role():
+    cfg = normalize_council_config(_payload(name="x" * 200, role="y" * 2000))
+    member = cfg["presets"]["p"]["members"][0]
+    assert len(member["name"]) <= 60
+    assert len(member["role"]) <= 500
+
+
+def test_normalize_non_string_name_role_degrades_at_read_time():
+    # Read-time tolerance: hand-edited junk is dropped, never crashes.
+    cfg = normalize_council_config(_payload(name=42, role=["not", "a", "string"]))
+    member = cfg["presets"]["p"]["members"][0]
+    assert "name" not in member
+    assert "role" not in member
+
+
+def test_normalize_judge_and_chairman_carry_name_but_never_role():
+    payload = _payload()
+    payload["presets"]["p"]["judge"] = {
+        "provider": "openrouter", "model": "judge-m", "name": "Magistrate", "role": "ignored"}
+    payload["presets"]["p"]["chairman"]["role"] = "ignored too"
+    cfg = normalize_council_config(payload)
+    judge = cfg["presets"]["p"]["judge"]
+    chair = cfg["presets"]["p"]["chairman"]
+    assert judge["name"] == "Magistrate"
+    assert "role" not in judge
+    assert chair["name"] == "The Chair"
+    assert "role" not in chair
+
+
+def test_resolve_preset_slots_carry_name_role():
+    preset = resolve_council_preset(_payload(name="Skeptic", role="Doubt everything."))
+    assert preset["members"][0]["name"] == "Skeptic"
+    assert preset["members"][0]["role"] == "Doubt everything."
+    assert preset["chairman"]["name"] == "The Chair"
+
+
+def test_council_config_complete_ignores_name_role():
+    # name/role are optional and never required for completeness.
+    assert council_config_complete(_payload()["presets"]["p"]) is True
+    bare = {"members": [{"provider": "a", "model": "b"}], "chairman": {"provider": "c", "model": "d"}}
+    assert council_config_complete(bare) is True
+
+
+# ── validate: write-boundary rejection ──────────────────────────────────────
+
+
+def test_validate_accepts_string_name_and_role():
+    assert validate_council_payload(_payload(name="Skeptic", role="Doubt everything.")) == []
+
+
+def test_validate_rejects_non_string_role():
+    problems = validate_council_payload(_payload(role=123))
+    assert problems
+    assert any("role" in p for p in problems)
+
+
+def test_validate_rejects_non_string_name():
+    problems = validate_council_payload(_payload(name={"not": "a string"}))
+    assert problems
+    assert any("name" in p for p in problems)
+
+
+def test_validate_rejects_non_string_name_on_judge_and_chairman():
+    payload = _payload()
+    payload["presets"]["p"]["judge"] = {"provider": "openrouter", "model": "j", "name": 7}
+    payload["presets"]["p"]["chairman"]["name"] = ["x"]
+    problems = validate_council_payload(payload)
+    assert problems
+    assert any("judge" in p and "name" in p for p in problems)
+    assert any("chairman" in p and "name" in p for p in problems)
+
+
+# ── save/load round-trip ────────────────────────────────────────────────────
+
+
+def test_save_and_load_preserves_name_and_role(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    saved = save_council_config(_payload(name="Skeptic", role="Doubt everything."))
+    assert saved["presets"]["p"]["members"][0]["name"] == "Skeptic"
+
+    from hermes_cli.config import load_config
+    on_disk = load_config().get("council") or {}
+    again = normalize_council_config(on_disk)
+    member = again["presets"]["p"]["members"][0]
+    assert member["name"] == "Skeptic"
+    assert member["role"] == "Doubt everything."
+    assert again["presets"]["p"]["chairman"]["name"] == "The Chair"
