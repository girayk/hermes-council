+def _raw_config_has_enabled_council_preset() -> bool:
+    """True when the user's RAW config enables Council: ``load_config()`` merges the DEFAULT_CONFIG
+    preset for everyone, which is not a user choice; visible once one enabled preset (or legacy flat
