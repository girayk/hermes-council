+): boolean {
+  if (!model.trim() || provider.trim().toLowerCase() !== 'council') {
+    return false
+  }
+
+  const providers = options?.providers
+
+  if (!providers || providers.length === 0) {
+    return false
+  }
+
+  const row = providers.find(p => (p.slug || p.name || '').toLowerCase() === 'council')
+
+  return !(row?.models ?? []).includes(model)
+}
