+                    "presets": {name: _council_preset_dict(preset) for name, preset in body.presets.items()},
+                }
+            else:
+                raw = _council_preset_dict(body)  # legacy flat payload from older clients
+
+            # Reject-don't-repair (mirrors the MoA route, #64156): normalize_council_config()
+            # silently swaps incomplete slots for defaults — correct at READ time, data loss at
+            # WRITE time.
+            problems = validate_council_payload(raw)
+            if problems:
+                raise HTTPException(status_code=422, detail="Invalid Council config: " + "; ".join(problems))
+            normalized = normalize_council_config(raw)
+            # Contract section 5: a preset needs a complete chairman slot AND >= 1 enabled member.
+            for preset_name, preset in normalized["presets"].items():
+                if not council_config_complete(preset):
+                    raise HTTPException(
+                        status_code=400,
+                        detail=(f"Council preset '{preset_name}' is incomplete: a chairman slot and "
+                                "at least one enabled member are required."))
+            # Merge, don't overwrite; write ONLY the council section (see the MoA route's
+            # #58819/#89184 rationale) — save_council_config owns that merge.
+            normalized = save_council_config(raw)
+            return {"ok": True, **normalized}
+
