+    for call in reviews:
+        blob = _all_message_text(call)
+        assert NAME_SENTINEL not in blob
+        assert ROLE_SENTINEL not in blob
+        assert ROLE_ONLY_SENTINEL not in blob
+        assert "ChairName" not in blob
+        assert "Response A" in blob
+        assert "openrouter:member-1" not in blob  # pre-existing model-id anonymity holds
