         "presets": presets,
-        # Compatibility/flattened view of the default preset for dashboard/desktop callers.
-        **{key: deepcopy(presets[default_name][key]) for key in _FLAT_PRESET_KEYS}}
+        # Compatibility/flattened view of the single preset for dashboard/desktop callers.
+        **{key: deepcopy(presets[DEFAULT_COUNCIL_PRESET_NAME][key]) for key in _FLAT_PRESET_KEYS}}
 
 
